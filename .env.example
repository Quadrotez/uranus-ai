# Uranus-AI local configuration. Copy to .env; never commit the copy.
APP_ENV=development
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-token
DATA_DIR=/data
WORKSPACE_DIR=/workspace
SANDBOX_URL=http://sandbox:5001
BROWSER_URL=http://browser:5002
API_PORT=8000
WEB_PORT=5173
URANUS_UID=1000
URANUS_GID=1000

# API-only host gateway for local model proxies. Keep the default on Linux/Docker Desktop.
PROXY_HOSTNAME=host.docker.internal

# Optional bootstrap admin key for local single-user mode.
ADMIN_TOKEN=change-me

# The built-in provider is configured from the admin panel. These are optional bootstrap values.
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
